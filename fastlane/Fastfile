require "open3"

default_platform(:ios)

DUPLICATE_PODSPEC_ERROR = "Unable to accept duplicate entry for:".freeze

# Pushes a podspec to CocoaPods Trunk with configurable retry logic.
#
# If a push fails with a duplicate entry error (e.g. if the podspec already exists on CocoaPods Trunk,
# or if a prior attempt succeeded remotely despite a local network timeout/error), it is treated
# as a success so that the CI/CD pipeline does not fail unnecessarily.
#
# @param path [String] Relative or absolute path to the `.podspec` file to push.
# @param retry_count [Integer] Number of retry attempts on failure (default: 0).
#
def push_podspec(path:, retry_count: 0)
  command = ["pod", "trunk", "push", path]

  max_attempts = retry_count + 1

  1.upto(max_attempts) do |attempt|
    UI.command(command.join(" "))

    # Execute `pod trunk push` and capture combined output and process status
    stdout, stderr, status = Open3.capture3(*command)
    output = [stdout, stderr].compact.join.strip

    UI.message(output) unless output.empty?

    # Successfully published to CocoaPods Trunk
    return if status.success?

    # If the podspec is already published on CocoaPods Trunk (or a previous attempt succeeded despite a network error),
    # treat the duplicate entry error as a successful push.
    if output.include?(DUPLICATE_PODSPEC_ERROR)
      UI.success("Podspec already exists on attempt #{attempt}. Treating as success.")
      return
    end

    error_message = output.empty? ? "pod trunk push failed with exit status #{status.exitstatus}" : output

    # Retry if remaining attempts are available; otherwise raise a user error
    if attempt < max_attempts
      UI.important(
        "pod trunk push failed on attempt #{attempt}/#{max_attempts}. Retrying... \nError: #{error_message}"
      )
    else
      UI.user_error!(error_message)
    end
  end
end

platform :ios do
  desc "push PMPublicIntTest to CocoaPods repo"
  lane :releasePMPublicIntTest do
    push_podspec(
      path: "../PMPublicIntTest.podspec",
      retry_count: 1
    )
  end
end
