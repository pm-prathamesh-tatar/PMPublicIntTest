require "open3"

default_platform(:ios)

DUPLICATE_PODSPEC_ERROR = "Unable to accept duplicate entry for:".freeze

def push_podspec(path:, retry_count: 0)
  command = ["pod", "trunk", "push", path]

  max_attempts = retry_count + 1

  1.upto(max_attempts) do |attempt|
    UI.command(command.join(" "))

    stdout, stderr, status = Open3.capture3(*command)
    output = [stdout, stderr].compact.join.strip

    UI.message(output) unless output.empty?

    return if status.success?

    error_message =
      output.empty? ? "pod trunk push failed with exit status #{status.exitstatus}" : output

    if output.include?(DUPLICATE_PODSPEC_ERROR)
      if attempt == 1
        UI.user_error!(error_message)
      else
        UI.success("Podspec already exists on attempt #{attempt}. Treating as success.")
        return
      end
    end

    if attempt < max_attempts
      UI.important(
        "pod trunk push failed on attempt #{attempt}/#{max_attempts}. Retrying... Error: #{error_message}"
      )
    else
      UI.user_error!(error_message)
    end
  end
end

platform :ios do
  desc "push PMPublicIntTest to CocoaPods repo"
  lane :releasePMPublicIntTest do
    push_podspec(
      path: "../PMPublicIntTest.podspec",
      retry_count: 1
    )
  end
end
